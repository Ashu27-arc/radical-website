# Website API/forms = Next.js only. Forms ka data radicalDb mein.
# Blogs CRM se fetch (radical-crm DB), real-time WebSocket se update.

# WebSocket – CRM se blog post/update par website ko real-time update
NEXT_PUBLIC_WS_URL=ws://https://backend-radical.onrender.com

# CRM API – blogs yahan se fetch (radical-crm DB mein stored)
NEXT_PUBLIC_CRM_API_URL=https://backend-radical.onrender.com

# MongoDB (server-side) – website ka DB: institute, resume, counselor forms
MONGODB_URI=mongodb+srv://ashutoshrbinarama12:MwOPNj4llUcgNT7S@cluster0.tvnjbto.mongodb.net/radicalDb
# MONGODB_URI=mongodb://localhost:27017/radicalDb

# Google Places API – server-side only (never exposed to browser)
# 1. Google Cloud Console → Enable "Places API"
# 2. Create an API key → restrict to your domain + Places API
# 3. Find your Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE
GOOGLE_PLACE_ID=YOUR_GOOGLE_PLACE_ID_HERE